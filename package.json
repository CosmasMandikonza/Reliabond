{
  "name": "reliabond",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Reliability Exchange - SLA bonds enforced by autonomous agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/reliabond"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "deploy:mcp": "cd packages/mcp-reliabond && pnpm deploy",
    "probe": "cd packages/agent-probe && pnpm start",
    "reliability": "cd packages/agent-reliability && pnpm start"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
