# ===========================================
# RELIABOND ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# ---- MCP Server ----
MCP_SERVER_URL=http://localhost:8787
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# ---- Thirdweb Configuration ----
THIRDWEB_CLIENT_ID=your_thirdweb_client_id
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key

# Chain configuration (Base Sepolia testnet by default)
CHAIN_ID=84532
CHAIN_NAME=base-sepolia
RPC_URL=https://sepolia.base.org

# Contract addresses (set after deployment)
SLA_BOND_CONTRACT_ADDRESS=0x...
TEST_ERC20_ADDRESS=0x...

# Agent executor wallet (private key for signing on-chain txs)
AGENT_EXECUTOR_PRIVATE_KEY=0x...

# ---- Edenlayer (Optional) ----
EDENLAYER_API_URL=https://api.edenlayer.xyz
EDENLAYER_API_KEY=your_edenlayer_key

# ---- Nullshot Agent Framework ----
OPENAI_API_KEY=your_openai_key
# or use Anthropic
ANTHROPIC_API_KEY=your_anthropic_key
# ---- Frontend ----
NEXT_PUBLIC_MCP_URL=http://localhost:8787
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id
